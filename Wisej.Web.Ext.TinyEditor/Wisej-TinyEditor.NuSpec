<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>Wisej-4-TinyEditor</id>
    <title>Wisej.NET 4 Tiny Editor Extension</title>
    <tags>Real-Time-Web Full-Stack-Web-Development WinForms-to-Web VisualStudio-Web-Development Wisej-4 NETCore NETFramework iOs Android MacCatalyst Windows10 Control</tags>
    <copyright>Copyright (C) Ice Tea Group LLC, All Rights Reserved.</copyright>
    <authors>Ice Tea Group LLC</authors>
    <owners>Wisej</owners>
    <version>$version$</version>
    <projectUrl>http://wisej.com/</projectUrl>
    <repository type="git" url="https://github.com/iceteagroup/wisej-extensions/tree/4.0/Wisej.Web.Ext.TinyEditor" />
    <icon>images\Wisej.png</icon>
    <description>
The TinyEditor extension uses a simple, lightweight (under 9KB) and standalone JavaScript WYSIWYG editor. It handles most of the basic formatting and has some functionality built in to help keep the rendered markup as clean as possible.
    </description>
    <summary>
        TinyEditor integration for Wisej.NET.
    </summary>
    <releaseNotes>
        Please visit https://wisej.com/release-notes/?milestone=$version$ to view the release notes.
    </releaseNotes>
    <language>en-US</language>
    <!--
      Under dependencies include only other NuGet packages.
    -->
    <dependencies>
      <dependency id="Wisej-4" version="$version$" />
    </dependencies>
  </metadata>
  <files>
