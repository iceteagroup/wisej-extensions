    <file src="..\..\Distro\bin\net8.0-ios\Wisej.Ext.FuzzySort.dll" target="lib/net8.0-ios14.2" />
    <file src="..\..\Distro\bin\net8.0-ios\Wisej.Ext.FuzzySort.xml" target="lib/net8.0-ios14.2" />

