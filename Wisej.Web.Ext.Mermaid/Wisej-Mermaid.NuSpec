<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>Wisej-4-Mermaid</id>
    <title>Wisej.NET 4 Mermaid Extension</title>
    <tags>Real-Time-Web Full-Stack-Web-Development WinForms-to-Web VisualStudio-Web-Development Wisej-4 Mermaid Diagram</tags>
    <copyright>Copyright (C) Ice Tea Group LLC, All Rights Reserved.</copyright>
    <authors>Ice Tea Group LLC</authors>
    <owners>Wisej</owners>
    <version>$version$</version>
    <projectUrl>http://wisej.com/</projectUrl>
    <repository type="git" url="https://github.com/iceteagroup/wisej-extensions/tree/4.0/Wisej.Web.Ext.Mermaid" />
    <icon>images\Wisej.png</icon>
    <description>
The Mermaid extension component renders Mermaid diagrams (https://mermaid.js.org/) in Wisej.NET.
    </description>
    <summary>
        Mermaid integration for Wisej.NET.
    </summary>
    <releaseNotes>
        Please visit https://wisej.com/release-notes/?milestone=$version$ to view the release notes.
    </releaseNotes>
    <language>en-US</language>
    <dependencies>
      <dependency id="Wisej-4" version="$version$" />
      <dependency id="System.Text.Json" version="8.0.5" />
    </dependencies>
  </metadata>
  <files>
