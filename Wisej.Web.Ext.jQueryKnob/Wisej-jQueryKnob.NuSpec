    <file src="..\..\Distro\bin\net8.0-ios\Wisej.Web.Ext.jQueryKnob.dll" target="lib/net8.0-ios14.2" />
    <file src="..\..\Distro\bin\net8.0-ios\Wisej.Web.Ext.jQueryKnob.xml" target="lib/net8.0-ios14.2" />

