<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>Wisej-3-VaadinIcons</id>
    <title>Wisej.NET 3 – VaadinIcons Extension</title>
    <tags>Real-Time-Web Full-Stack-Web-Development WinForms-to-Web VisualStudio-Web-Development Wisej-3 NET7 NET48 Icon-Pack</tags>
    <copyright>Copyright (C) Ice Tea Group LLC, All Rights Reserved.</copyright>
    <authors>Ice Tea Group LLC</authors>
    <owners>Wisej</owners>
    <version>$version$</version>
    <projectUrl>http://wisej.com/</projectUrl>
    <repository type="git" url="https://github.com/iceteagroup/wisej-extensions/tree/3.5/Wisej.Ext.VaadinIcons" />
    <icon>images\Wisej.png</icon>
    <description>
The complete VaadinIcons icon pack (https://github.com/vaadin/vaadin-icons). All icons are packed as individual svg resources in a single assembly. Use it by adding the Wisej.Ext.VaadinIcons assembly to the references and select the icon using the image editor at design time. The URL is resource.wx/Wisej.Ext.VaadinIcons/{icon-name}.
    </description>
    <summary>
        VaadinIcons integration for Wisej.NET.
    </summary>
    <releaseNotes>
        Please visit https://wisej.com/release-notes/?milestone=$version$ to view the release notes.
    </releaseNotes>
    <language>en-US</language>
    <!--
      Under dependencies include only other NuGet packages.
    -->
    <dependencies>
      <dependency id="Wisej-3" version="$version$" />
    </dependencies>
  </metadata>
  <files>
    <file src="..\Wisej.png" target="images/" />
    <file src="..\..\Distro\bin\net48\Wisej.Ext.VaadinIcons.dll" target="lib/net48" />
    <file src="..\..\Distro\bin\net8.0\Wisej.Ext.VaadinIcons.dll" target="lib/net8.0" />
  </files>
</package>