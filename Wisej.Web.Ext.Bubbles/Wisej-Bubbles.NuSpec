<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>Wisej-4-Bubbles</id>
    <title>Wisej.NET 4 – Bubbles Extension</title>
    <tags>Real-Time-Web Full-Stack-Web-Development WinForms-to-Web VisualStudio-Web-Development Wisej-4 NETCore NETFramework iOs Android MacCatalyst Windows10 Component</tags>
    <copyright>Copyright (C) Ice Tea Group LLC, All Rights Reserved.</copyright>
    <authors>Ice Tea Group LLC</authors>
    <owners>Wisej</owners>
    <version>$version$</version>
    <projectUrl>http://wisej.com/</projectUrl>
    <repository type="git" url="https://github.com/iceteagroup/wisej-extensions/tree/4.0/Wisej.Web.Ext.Bubbles" />
    <icon>images\Wisej.png</icon>
    <description>
    The Bubbles extender component enhances all Wisej.NET components by providing additional properties and a useful bubble notification functionality. Every widget can display a popup animated and themed bubble when a value changes
    </description>
    <summary>
        Bubble integration for Wisej.NET.
    </summary>
    <releaseNotes>
        Please visit https://wisej.com/release-notes/?milestone=$version$ to view the release notes.
    </releaseNotes>
    <language>en-US</language>
    <!--
      Under dependencies include only other NuGet packages.
    -->
    <dependencies>
      <dependency id="Wisej-4" version="$version$" />
    </dependencies>
  </metadata>
