<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>Wisej-3-FuzzySort</id>
    <title>Wisej.NET 3 – FuzzySort Extension</title>
    <tags>Real-Time-Web Full-Stack-Web-Development WinForms-to-Web VisualStudio-Web-Development Wisej-4 NETCore NETFramework iOS Android MacCatalyst Windows10 Web-Api</tags>
    <copyright>Copyright (C) Ice Tea Group LLC, All Rights Reserved.</copyright>
