<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>Wisej-3-TablerIcons</id>
    <title>Wisej.NET – 3 Tabler Icons Extension</title>
    <tags>Real-Time-Web Full-Stack-Web-Development WinForms-to-Web VisualStudio-Web-Development Wisej-3 NET7 NET48 Icon-Pack</tags>
    <copyright>Copyright (C) Ice Tea Group LLC, All Rights Reserved.</copyright>
    <authors>Ice Tea Group LLC</authors>
    <owners>Wisej</owners>
    <version>$version$</version>
    <projectUrl>http://wisej.com/</projectUrl>
    <repository type="git" url="https://github.com/iceteagroup/wisej-extensions/tree/3.5/Wisej.Ext.TablerIcons" />
    <icon>images\Wisej.png</icon>
    <description>
        This package contains the Tabler icon set for SVG icons packaged in a Wisej.NET IconPack assembly.
    </description>
    <summary>
        Tabler Icon Pack for Wisej.NET.
    </summary>
    <releaseNotes>
        Please visit https://wisej.com/release-notes/?milestone=$version$ to view the release notes.
    </releaseNotes>
    <language>en-US</language>
    <!--
      Under dependencies include only other NuGet packages.
    -->
    <dependencies>
      <dependency id="Wisej-3" version="$version$" />
    </dependencies>
  </metadata>
  <files>
    <file src="..\Wisej.png" target="images/" />
    <file src="..\..\Distro\bin\net48\Wisej.Ext.TablerIcons.dll" target="lib/net48" />
    <file src="..\..\Distro\bin\net8.0\Wisej.Ext.TablerIcons.dll" target="lib/net8.0" />
  </files>
</package>