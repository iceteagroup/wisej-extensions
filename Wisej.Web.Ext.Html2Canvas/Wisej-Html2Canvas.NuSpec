<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>Wisej-3-Html2Canvas</id>
    <title>Wisej.NET 3 – Html2Canvas Extension</title>
    <tags>Real-Time-Web Full-Stack-Web-Development WinForms-to-Web VisualStudio-Web-Development Wisej-3 NET7 NET48 iOs Android MacCatalyst Windows10 Component</tags>
    <copyright>Copyright (C) Ice Tea Group LLC, All Rights Reserved.</copyright>
    <authors>Ice Tea Group LLC</authors>
    <owners>Wisej</owners>
    <version>$version$</version>
    <projectUrl>http://wisej.com/</projectUrl>
    <repository type="git" url="https://github.com/iceteagroup/wisej-extensions/tree/3.5/Wisej.Web.Ext.Html2Canvas" />
    <icon>images\Wisej.png</icon>
    <description>
	The Html2Canvas extension component uses the Html2Canvas library (https://html2canvas.hertzen.com/). This Wisej.NET component that can take a screenshot of a specific control or the entire browser and send the image back to the server.
    </description>
    <summary>
        Html2Canvas integration for Wisej.NET.
    </summary>
    <releaseNotes>
        Please visit https://wisej.com/release-notes/?milestone=$version$ to view the release notes.
    </releaseNotes>
    <language>en-US</language>
    <!--
      Under dependencies include only other NuGet packages.
    -->
    <dependencies>
      <dependency id="Wisej-3" version="$version$" />
    </dependencies>
  </metadata>
  <files>
    <file src="..\Wisej.png" target="images/" />
    
