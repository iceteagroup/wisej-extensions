<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>Wisej-4-ModernUI</id>
    <title>Wisej.NET 4 ModernUI Extension</title>
    <tags>Real-Time-Web Full-Stack-Web-Development WinForms-to-Web VisualStudio-Web-Development Wisej-4 NETCore NETFramework Icon-Pack</tags>
    <copyright>Copyright (C) Ice Tea Group LLC, All Rights Reserved.</copyright>
    <authors>Ice Tea Group LLC</authors>
    <owners>Wisej</owners>
    <version>$version$</version>
    <projectUrl>http://wisej.com/</projectUrl>
    <repository type="git" url="https://github.com/iceteagroup/wisej-extensions/tree/4.0/Wisej.Ext.ModernUI" />
    <icon>images\Wisej.png</icon>
    <description>
        The complete http://modernuiicons.com/ icon pack – (1,259 icons!). All icons are packed as individual svg resources in a single assembly.
    </description>
    <summary>
        ModernUI integration for Wisej.NET.
    </summary>
    <releaseNotes>
        Please visit https://wisej.com/release-notes/?milestone=$version$ to view the release notes.
    </releaseNotes>
    <language>en-US</language>
    <!--
      Under dependencies include only other NuGet packages.
    -->
    <dependencies>
      <dependency id="Wisej-4" version="$version$" />
    </dependencies>
  </metadata>
  <files>
    <file src="..\Wisej.png" target="images/" />
    <file src="..\..\Distro\bin\net48\Wisej.Ext.ModernUI.dll" target="lib/net48" />
    <file src="..\..\Distro\bin\net8.0\Wisej.Ext.ModernUI.dll" target="lib/net8.0" />
  </files>
</package>