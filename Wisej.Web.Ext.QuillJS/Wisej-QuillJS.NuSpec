    <icon>images\Wisej.png</icon>
    <description>
The QuillJS https://quilljs.com/ extension is a platform-independent, browser-based WYSIWYG editor control, written in JavaScript and released as open-source software under the BSD-3 License by Slab.
    </description>
    <summary>
        QuillJS integration for Wisej.NET.
    </summary>
    <releaseNotes>
        Please visit https://wisej.com/release-notes/?milestone=$version$ to view the release notes.
    </releaseNotes>
    <language>en-US</language>
    <!--
      Under dependencies include only other NuGet packages.
    -->
    <dependencies>
      <dependency id="Wisej-4" version="$version$" />
    </dependencies>
