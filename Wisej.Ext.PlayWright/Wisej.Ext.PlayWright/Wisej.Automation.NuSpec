<?xml version="1.0" encoding="utf-8"?>

<package>
	<metadata>
		<id>Wisej-Automation</id>
		<title>Wisej UI Test Automation Package</title>
		<tags>Real-Time-Web Full-Stack-Web-Development WinForms-to-Web VisualStudio-Web-Development</tags>
		<copyright>Copyright (C) Ice Tea Group LLC, All Rights Reserved.</copyright>
		<authors>Ice Tea Group LLC</authors>
		<owners>Wisej</owners>
		<version>1.1.0</version>
		<projectUrl>http://wisej.com/</projectUrl>
		<description>
			This package contains helper functions to use Playwright for UI Test automation
		</description>
		<summary>
			Playwright integration for Wisej.
		</summary>

		<releaseNotes>
			Please visit https://wisej.com/release-notes/?milestone=$version$ to view the release notes.
		</releaseNotes>

		<language>en-US</language>
		<!--
      Under dependencies include only other NuGet packages.
    -->
		<dependencies>
			<dependency id="Microsoft.Playwright" version="1.32.0" />
		</dependencies>
	</metadata>
	<files>
                <file src="..\..\Distro\bin\net8.0\Wisej.Ext.PlayWright.dll" target="lib/net8.0" />
                <file src="..\..\Distro\bin\net8.0\Wisej.Ext.PlayWright.xml" target="lib/net8.0" />
        </files>
</package>