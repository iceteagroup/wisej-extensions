<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>Wisej-3-AmazonS3</id>
    <title>Wisej.NET 3 – Amazon S3 File System Extension</title>
    <tags>Real-Time-Web Full-Stack-Web-Development WinForms-to-Web VisualStudio-Web-Development Wisej-3 NET6 NET48 Component</tags>
    <copyright>Copyright (C) Ice Tea Group LLC, All Rights Reserved.</copyright>
    <authors>Ice Tea Group LLC</authors>
    <owners>Wisej</owners>
    <version>$version$</version>
    <projectUrl>http://wisej.com/</projectUrl>
    <repository type="git" url="https://github.com/iceteagroup/wisej-extensions/tree/3.5/Wisej.Ext.FileSystem.AmazonS3" />
    <icon>images\Wisej.png</icon>
    <description>
        This package contains the https://aws.amazon.com/s3/ integration assembly for Wisej.NET. It implements the Wisej.Core.IFileSystemProvider interface and it can be used as a root file system with the Wisej.Web.FileDialog component.
    </description>
    <summary>
        AmazonS3 integration for Wisej.NET.
    </summary>
    <releaseNotes>
        Please visit https://wisej.com/release-notes/?milestone=$version$ to view the release notes.
    </releaseNotes>
    <language>en-US</language>
    <!--
      Under dependencies include only other NuGet packages.
    -->
    <dependencies>
      <dependency id="Wisej-3" version="$version$" />
    </dependencies>
  </metadata>
  <files>
    <file src="..\Wisej.png" target="images/" />
    <file src="..\..\Distro\bin\net48\Wisej.Ext.FileSystem.AmazonS3.dll" target="lib/net48" />
    <file src="..\..\Distro\bin\net48\Wisej.Ext.FileSystem.AmazonS3.xml" target="lib/net48" />

